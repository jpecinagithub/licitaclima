# LicitaClima — copia a .env y completa SOLO lo que tengas. Nada de esto va a git.
# Sin secretos reales: los valores de ejemplo son marcadores, no credenciales.
# Las integraciones PENDIENTES (LLM, Stripe, correo) se dejan vacías hasta que
# Jon aporte proveedor y claves; el código las trata como no configuradas
# (respuestas 503 / 'pending' explícitas, nunca simuladas como operativas).

# Base de datos PostgreSQL 16 (local: docker compose up db, o PostgreSQL instalado)
DATABASE_URL=postgres://licitaclima:licitaclima@localhost:5432/licitaclima
# BD de test (PostgreSQL real). Cada fichero de test crea su propia BD
# (licitaclima_test_<azar>) y la borra al terminar; si no se define, usa
# DATABASE_URL como base para crearla.
TEST_DATABASE_URL=postgres://licitaclima:licitaclima@localhost:5432/licitaclima_test

# API / Web
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PORT=5173
WEB_PUBLIC_URL=http://localhost:5173
# Orígenes extra permitidos para CSRF/CORS, separados por comas (producción)
ALLOWED_ORIGINS=
# Dominio canónico de la web (prerender); marcador hasta que Jon confirme el dominio
LICITACLIMA_SITE_URL=https://licitaclima.es

# Sesiones y cifrado de secretos de admin. Al menos una de las dos es
# obligatoria: sin ADMIN_SECRETS_KEY ni SESSION_SECRET la API no cifra.
# Generar con: openssl rand -hex 32
SESSION_SECRET=cambia-esta-clave-larga-y-aleatoria
ADMIN_SECRETS_KEY=cambia-esta-clave-larga-y-aleatoria

# Documentos descargados (pliegos). Por defecto ./data/documents del worker.
DOCUMENTS_DIR=./apps/worker/data/documents

# Entorno: development | production
NODE_ENV=development

# LLM — SIN proveedor configurado (PENDIENTE: Jon elige xAI o Top Tools AI)
# Sin proveedor, el adaptador es NoLlmProvider: no hay gasto ni respuestas.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Stripe — SOLO test, SIN claves (PENDIENTE)
# Las claves live están bloqueadas por diseño (503 live_blocked).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Correo — SIN proveedor configurado (PENDIENTE: outbox en BD sin envío)
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@licitaclima.es

# Admin bootstrap (se crea con: pnpm --filter @licitaclima/api exec tsx src/cli.ts admin:create)
ADMIN_EMAIL=
