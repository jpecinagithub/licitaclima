# LicitaClima — copia a .env y completa SOLO lo que tengas. Nada de esto va a git.
# Base de datos PostgreSQL (local: docker compose up db, o PostgreSQL instalado)
DATABASE_URL=postgres://licitaclima:licitaclima@localhost:5432/licitaclima
# API / Web
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PORT=5173
SESSION_SECRET=cambia-esta-clave-larga-y-aleatoria
# LLM — SIN proveedor configurado (PENDIENTE: Jon elige xAI o Top Tools AI)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Stripe — SOLO test, SIN claves (PENDIENTE)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Correo — SIN proveedor configurado (PENDIENTE: outbox en BD sin envío)
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@licitaclima.es
# Admin bootstrap (se crea con: pnpm --filter @licitaclima/api exec tsx src/cli.ts admin:create)
ADMIN_EMAIL=
